    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; color: #0f172a; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        .input-field { width: 100%; border: 1px solid #e2e8f0; border-radius: 0.5rem; padding: 0.625rem 1rem; outline: none; transition: all 0.2s; font-size: 0.875rem; background-color: #ffffff; color: #1e293b; font-weight: 500; }
        .input-field:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15); }
        .input-field:disabled { background-color: #f1f5f9; cursor: not-allowed; opacity: 0.7; }
        
        .btn-primary { background-color: #2563eb; color: white; padding: 0.625rem 1.25rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.875rem; transition: all 0.2s; box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2); display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; border: none; cursor: pointer; }
        .btn-primary:hover { background-color: #1d4ed8; box-shadow: 0 4px 6px rgba(37, 99, 235, 0.3); transform: translateY(-1px); }
        .btn-primary:active { transform: translateY(0); }
        .btn-primary:disabled { background-color: #94a3b8; box-shadow: none; cursor: not-allowed; transform: none; }
        
        .btn-secondary { background-color: #ffffff; color: #334155; padding: 0.625rem 1.25rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.875rem; border: 1px solid #cbd5e1; transition: all 0.2s; cursor: pointer; box-shadow: 0 1px 2px rgba(0,0,0,0.05); display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; }
        .btn-secondary:hover { background-color: #f1f5f9; border-color: #94a3b8; }
        
        .card-shadow { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); }
        .label-text { display: block; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 0.35rem; letter-spacing: 0.05em; }
        .hidden-view { display: none !important; }
        
        #toast-container { position: fixed; top: 1rem; right: 1rem; z-index: 9999; display: flex; flex-direction: column; gap: 0.5rem; pointer-events: none; }
        .toast { padding: 1rem; border-radius: 0.5rem; color: white; font-weight: 500; font-size: 0.875rem; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); display: flex; align-items: center; gap: 0.5rem; animation: slideIn 0.3s ease forwards; pointer-events: auto; }
        .toast.success { background-color: #10b981; } .toast.error { background-color: #ef4444; }
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        
        .login-bg { background-color: #0f172a; background-image: radial-gradient(circle at 50% -20%, #1e293b, #0f172a); }
        .glass-panel { background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(10px); }

        .table-compact th, .table-compact td { padding: 0.75rem 1rem; white-space: nowrap; width: 1%; }
        .table-compact th:last-child, .table-compact td:last-child { width: auto; }

        .breakdown-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.8rem; }
        .breakdown-table th { background-color: #5a52e5; color: white; padding: 0.5rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.7rem; border: 1px solid #4a42d5; }
        .breakdown-table th:first-child { border-top-left-radius: 0.5rem; } .breakdown-table th:last-child { border-top-right-radius: 0.5rem; }
        .breakdown-table td { padding: 0.5rem; border: 1px solid #e2e8f0; color: #334155; }
        .breakdown-table .variant-cell { background-color: #f8fafc; font-weight: 700; color: #1e293b; vertical-align: top; }
        .breakdown-table .total-subtext { display: block; font-weight: normal; color: #6366f1; font-size: 0.7rem; margin-top: 0.2rem; }

        .tab-btn { border-bottom: 2px solid transparent; padding-bottom: 0.5rem; color: #64748b; font-weight: 600; transition: all 0.2s; outline: none; border-radius: 0; background: transparent; cursor: pointer;}
        .tab-btn.active { border-bottom-color: #4f46e5; color: #4f46e5; } .tab-btn:hover:not(.active) { color: #1e293b; }
        
        .pivot-wrapper { width: 100%; overflow-x: auto; border-radius: 0.5rem; }
        .pivot-table { border-collapse: collapse; width: max-content; background-color: white; margin-bottom: 1rem; }
        .pivot-table th, .pivot-table td { border: 1px solid #cbd5e1; padding: 0.6rem 1.5rem; vertical-align: middle; white-space: nowrap; }
        .pivot-table thead th { background-color: #2563eb; color: white; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; border-color: #1d4ed8; }
        .pivot-table .model-row { background-color: #f8fafc; font-weight: 700; color: #1e293b; border-bottom: 1px solid #cbd5e1; }
        .pivot-table .variant-row { font-weight: 600; color: #334155; } .pivot-table .colour-row { color: #475569; font-size: 0.85rem; }
        .pivot-table .subtotal-row td { background-color: #eff6ff; font-weight: 700; color: #1d4ed8; font-size: 0.8rem; border-top: 2px solid #bfdbfe; }
        .pivot-table .grand-total-row td { background-color: #1e293b; color: white; font-weight: 800; font-size: 0.95rem; border-color: #0f172a; }
        .pivot-qty { color: #1d4ed8; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; background: transparent; border: 0; padding: 0.2rem 0.45rem; border-radius: 0.35rem; }
        .pivot-qty:hover { background: #dbeafe; color: #1e40af; }

        /* Compact workspace layout for dense inventory screens */
        main { padding: 1rem 1.25rem !important; }
        body.mobile-nav-open #mobile-nav-backdrop { display: block !important; }
        body.mobile-nav-open { overflow: hidden; }
        #app-screen.hidden #mobile-nav-toggle { display: none !important; }
        #app-screen.hidden #mobile-nav-backdrop { display: none !important; }
        #app-screen.hidden #app-sidebar { transform: translateX(-100%) !important; }

        @media (max-width: 767px) {
            #app-screen { position: relative; overflow: hidden; }
            #mobile-nav-toggle { top: 0.85rem; left: 0.85rem; z-index: 60; }
            #app-sidebar {
                position: fixed !important;
                inset: 0 auto 0 0 !important;
                width: min(82vw, 300px) !important;
                max-width: 300px !important;
                height: 100vh !important;
                max-height: 100dvh !important;
                display: flex !important;
                flex-direction: column !important;
                transform: translateX(-100%) !important;
                transition: transform 0.2s ease;
                z-index: 50;
                box-shadow: 0 20px 40px rgba(15, 23, 42, 0.3);
            }
            #app-sidebar nav { min-height: 0; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
            #app-sidebar > div:last-child { flex-shrink: 0; }
            body.mobile-nav-open #app-sidebar { transform: translateX(0) !important; }
            body.mobile-nav-open main { pointer-events: none; opacity: 0.35; }
            body.mobile-nav-open #mobile-nav-backdrop { pointer-events: auto; }
            main { width: 100%; }
        }
        .app-view.space-y-6 > :not([hidden]) ~ :not([hidden]) { margin-top: 0.75rem; }
        .app-view h2 { font-size: 1.35rem; line-height: 1.2; }
        .app-view h2 + p { margin-top: 0.2rem; }
        .app-view > .flex.justify-between.items-end { margin-bottom: 0.25rem; }
        .app-view .tab-btn { padding-bottom: 0.35rem; font-size: 0.85rem; }
        .app-view .border-b.border-slate-200.mb-6 { margin-bottom: 0.75rem; gap: 1.25rem; }
        .app-view .pivot-table { font-size: 0.82rem; }
        .app-view .pivot-table th, .app-view .pivot-table td { padding: 0.4rem 0.9rem; }
        .app-view .pivot-table thead th { font-size: 0.78rem; }
        #view-liveStock > .bg-white.p-4 { padding: 0.75rem; }
        #view-liveStock > .bg-white.p-4 .input-field { padding-top: 0.45rem; padding-bottom: 0.45rem; }
        #view-liveStock #ls-view-pivot, #view-liveStock #ls-view-raw { height: calc(100vh - 190px); }
        #view-liveStock #ls-view-summary > div { height: calc(100vh - 230px); min-height: 320px; }
        .table-compact th, .table-compact td { padding: 0.55rem 0.75rem; }

        /* Report Table Styles requested by user */
        .report-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
        .report-table th, .report-table td { border: 1px solid #e5e7eb; padding: 8px 12px; }
        .report-table th { background-color: #f9fafb; text-align: left; font-weight: 600; }
        .report-table .type-header { background-color: #4f46e5; color: white; padding: 10px 14px; font-weight: 700; text-align: left; font-size: 0.9rem; letter-spacing: 0.05em; }
        .report-table .text-right { text-align: right; }
        .status-box { padding: 10px 14px; border-radius: 6px; font-weight: 600; font-size: 0.875rem; }
        .status-loading { background-color: #e0e7ff; color: #3730a3; border: 1px solid #c7d2fe; }
        .status-error { background-color: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

        @media (max-width: 767px) {
            body { overflow: hidden; }
            #app-screen { display: flex !important; }
            main { padding: 4.25rem 0.9rem 1rem !important; }
            #mobile-nav-toggle { display: flex !important; }
            .app-view { max-width: 100% !important; }
            .app-view h2 { font-size: 1.4rem; }
            .app-view .flex.items-center.justify-between { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
            .app-view .grid { grid-template-columns: 1fr !important; }
            .app-view .rounded-2xl, .app-view .rounded-xl { border-radius: 1rem; }
            #app-sidebar { max-width: 78vw; }

            #dispatch-form { padding: 0.9rem; }
            #dispatch-form > h3 { display: none; }
            #dispatch-form > .grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 0.7rem; margin-bottom: 0; }
            #dispatch-form > .grid > #remark-div { grid-column: 1 / -1; }
            #dispatch-form .label-text { font-size: 0.65rem; margin-bottom: 0.2rem; }
            #dispatch-form .input-field { padding: 0.55rem 0.65rem; font-size: 0.8rem; }

            #txn-modal { padding: 0.65rem; }
            #txn-modal > div { max-height: calc(100dvh - 1.3rem); }
            #txn-modal-content { padding: 1rem; gap: 1rem; overflow-y: auto; }
            #txn-modal-content .grid { gap: 1rem 0.75rem; }
            #txn-modal-content .text-lg { font-size: 1rem; }
            #txn-modal-footer { padding: 0.75rem 1rem; flex-shrink: 0; }
            #txn-modal-footer .btn-secondary { width: 100%; }

            #view-reports { gap: 0.75rem; }
            #view-reports > .flex.justify-between.items-end { flex-direction: row; align-items: center; gap: 0.5rem; }
            #view-reports > .flex.justify-between.items-end h2 { font-size: 1.15rem; }
            #view-reports > .flex.justify-between.items-end p { font-size: 0.7rem; line-height: 1.35; max-width: 12rem; }
            #view-reports > .flex.justify-between.items-end .btn-secondary { padding: 0.5rem 0.65rem; font-size: 0.7rem; flex-shrink: 0; }
            #view-reports > .flex.justify-between.items-end .btn-secondary i { font-size: 0.9rem; }
            #view-reports .report-filters { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.6rem; padding: 0.75rem; }
            #view-reports .report-filter-field { min-width: 0; }
            #view-reports .report-filter-field:nth-child(3), #view-reports .report-filter-field:nth-child(4) { grid-column: 1 / -1; }
            #view-reports .report-filters .label-text { font-size: 0.6rem; margin-bottom: 0.2rem; }
            #view-reports .report-filters .input-field { min-width: 0; padding: 0.5rem 0.55rem; font-size: 0.72rem; }
            #view-reports .report-summary-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important; gap: 0.6rem; }
            #view-reports .report-summary-card { padding: 0.7rem 0.75rem; border-radius: 0.75rem; }
            #view-reports .report-summary-card .label-text { font-size: 0.55rem; margin-bottom: 0; white-space: nowrap; }
            #view-reports .report-summary-card .report-summary-value { font-size: 1.35rem; line-height: 1; margin-top: 0.2rem; }
            #view-reports .report-history-table { min-width: 58rem; }
            #view-reports .report-history-table th,
            #view-reports .report-history-table td { white-space: nowrap; }
            #view-reports .report-history-table td:nth-child(4),
            #view-reports .report-history-table td:nth-child(5) { max-width: 14rem; overflow: hidden; text-overflow: ellipsis; }
            #view-reports .report-history-table th:last-child,
            #view-reports .report-history-table td:last-child { min-width: 16rem; }
        }

        @media print {
            body { background: white !important; margin: 0; padding: 0; }
            #app-screen > aside, .no-print { display: none !important; }
            main { padding: 0 !important; margin: 0 !important; overflow: visible !important; width: 100% !important; }
            .card-shadow { box-shadow: none !important; border: none !important; }
            .print-wrapper { width: 100%; margin: 0 auto; }
            
            .print-table { width: 100%; border-collapse: collapse; font-size: 11px; font-family: Arial, sans-serif; }
            .print-table th, .print-table td { border: 1px solid #000; padding: 4px; }
            .print-table th { background-color: #f3f4f6 !important; -webkit-print-color-adjust: exact; }
            
            .dotted-table { width: 100%; border-collapse: collapse; font-size: 12px; font-family: Arial, sans-serif; }
            .dotted-table th, .dotted-table td { border: 1px dashed #666; padding: 6px; }
            .dotted-table th { background-color: #eee !important; -webkit-print-color-adjust: exact; font-weight: bold; text-align: left; }
            .dotted-header-text { font-size: 24px; font-weight: bold; color: red !important; -webkit-print-color-adjust: exact; text-align: center; }
            
            /* Print style specifically for Stock Report */
            .report-table { font-size: 10px; width: 100% !important; }
            .report-table th, .report-table .type-header {
                -webkit-print-color-adjust: exact;
                color-adjust: exact;
            }
            .report-table .type-header {
                background-color: #4f46e5 !important;
                color: white !important;
            }
            
            .no-break { page-break-inside: avoid; }
            .app-view.hidden-view { display: none !important; }
        }
